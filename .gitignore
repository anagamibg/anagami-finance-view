# --- Secrets, backups and local-only material (S6 / P7) ---
# Every env variant stays out of git; only the example file is tracked.
.env.*
!.env.example
# Backups / dumps (never commit database or file backups)
*.backup
*.bak
*.sql
*.sql.gz
*.dump
*.tgz
*.tar.gz
# ...except Laravel's committed schema dump (no row data)
!/database/schema/mysql-schema.dump
# Keys, certificates, demo credentials
*.pem
*.key
demo-passwords*
# Local tooling and add-on code that lives only on the server / locally
.claude/
/Modules/
# Raw security evidence that must not be published
/docs/mvp/security/private/

# Upstream 6.0.19 (docs/ is ours and stays tracked)
public/app-icons/cache/*

public/monitor/installers/WorksuiteDemo-1.0.0.dmg
public/monitor/installers/WorksuiteDemoSetup-1.0.0.deb
public/monitor/installers/WorksuiteDemoSetup-1.0.0.exe
